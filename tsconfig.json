{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "#doc-model": ["./packages/doc-model/src/index.ts"],
      "#doc-model/*": ["./packages/doc-model/src/*"],
      "#canvas-format": ["./packages/canvas-format/src/index.ts"],
      "#canvas-format/*": ["./packages/canvas-format/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "packages/*/src/**/*.ts"]
}
